# Telegram Bot Token (from BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Anthropic API Key
CLAUDE_API_KEY=your_claude_api_key_here

# Google Sheets Configuration
GOOGLE_SHEETS_ID=your_google_sheets_id_here
